{
  "version": 2,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/index?path=.well-known/oauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/index?path=.well-known/oauth-authorization-server"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?path=:path*"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  }
}
