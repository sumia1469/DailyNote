    "test:browser": "node scripts/verify-ui.cjs",
    "test:memos": "node scripts/verify-memos.cjs",
    "test:files": "node scripts/verify-large-files.cjs",
    "test:imports": "node scripts/verify-text-import.cjs",
    "test:references": "node scripts/verify-references.cjs",
    "test:calendar": "node scripts/verify-calendar.cjs",
    "test:sections": "node scripts/verify-sections.cjs",
    "test:notices": "node scripts/verify-notice-pagination.cjs",
    "test:brand": "node scripts/verify-brand.cjs",
    "test:boards": "node scripts/verify-boards.cjs",
    "test:loading": "node scripts/verify-loading.cjs",
    "test:common-loading": "node scripts/verify-common-loading.cjs",
    "test:writing": "node scripts/verify-writing-forms.cjs",
    "test:license:browser": "node scripts/verify-license.cjs",
    "test:license:redis": "node scripts/verify-license-redis.cjs",
    "test:pull-refresh": "node scripts/verify-pull-refresh.cjs",
